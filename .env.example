# Copier ce fichier en .env (à la racine du dépôt) puis remplir les valeurs.
# Le fichier .env n'est jamais commité.

# --- Base de données (docker compose + API) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=change-me

# --- Sécurité ---
# Secret de signature des JWT (32 caractères minimum). Générer avec : openssl rand -hex 32
JWT_SECRET=
# Compte administrateur créé au premier démarrage (si aucun admin n'existe encore).
ADMIN_USERNAME=admin
# 10 caractères minimum. Si vide, un mot de passe aléatoire est généré et affiché une seule fois dans les logs.
ADMIN_PASSWORD=

# --- Assistant IA ---
# Clé API Anthropic (https://console.anthropic.com). Sans clé, le site fonctionne mais l'assistant est désactivé.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Origines autorisées (CORS) en production, séparées par des virgules. Inutile en dev (proxy Angular).
CORS_ALLOWED_ORIGINS=

# --- Notifications e-mail (facultatif) ---
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=votre adresse, SMTP_PASSWORD=mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Adresse qui reçoit les notifications de nouveaux messages
NOTIFY_EMAIL=
MAIL_FROM=
SITE_URL=http://localhost:4200
